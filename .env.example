# Copy to .env for local development:  cp .env.example .env
APP_ENV=local
LOG_LEVEL=INFO

FAMILY_ID=belchers
TABLE_NAME=pokemaker
ARTWORK_BUCKET=pokemaker-artwork-local
AWS_REGION=us-east-1

# Local stand-ins started by docker compose. No AWS account needed.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
LOCAL_AWS_ACCESS_KEY_ID=pokemaker
LOCAL_AWS_SECRET_ACCESS_KEY=pokemaker-secret

# Signs profile-unlock tokens (at least 32 characters). Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
PIN_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PIN_TOKEN_TTL_MINUTES=120
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=5

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# "mock" draws free placeholder creatures. Switch to "openai" (and set the key)
# to generate real artwork — each generation costs money.
ARTWORK_PROVIDER=mock
MOCK_ARTWORK_DELAY_SECONDS=1.5
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_TIMEOUT_SECONDS=90
OPENAI_ESTIMATED_COST_USD=0.02
DAILY_GENERATION_LIMIT=10
